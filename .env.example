# ShopSmart Backend Configuration
# ScaleMax AI Service Configuration (OpenAI-Compatible Token-Pack API)
SCALEMAX_BASE_URL=https://api.scalemax.pro/token/v1
SCALEMAX_API_KEY=
# Exact model ID from your ScaleMax token-pack catalog (e.g. deepseek-v4-flash, gpt-4o-mini, claude-3-5-sonnet, etc.)
SCALEMAX_MODEL=

# Granular Timeout & Deadline Settings (in seconds)
SCALEMAX_CONNECT_TIMEOUT=5.0
SCALEMAX_READ_TIMEOUT=20.0
SCALEMAX_RANKING_TIMEOUT=10.0
RETAILER_TIMEOUT=7.5
SEARCH_TOTAL_DEADLINE=18.0

# Local Server Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence
SQLITE_DB_PATH=shopsmart.db
